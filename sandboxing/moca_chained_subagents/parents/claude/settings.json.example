{
  "permissions": {
    "deny": [
      "Task",
      "Read(~/.config/mocactl/**)"
    ],
    "allow": [
      "Bash(rm -rf .moca-delegate)",
      "Bash(mkdir .moca-delegate)",
      "Bash(rm -r .moca-delegate)",
      "Bash(contextctl ctx pack*)",
      "Bash(mocactl spawn*)",
      "Bash(mocactl get*)",
      "Bash(mocactl subagents*)",
      "Bash(mocactl sessions*)",
      "Bash(mocactl workloads create*)",
      "Bash(mocactl workloads get*)",
      "Bash(mocactl workloads delete*)",
      "Bash(mocactl bundles delete*)",
      "Edit(.moca-delegate/**)"
    ]
  }
}
