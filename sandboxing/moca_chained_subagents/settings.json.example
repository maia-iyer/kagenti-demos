{
  "permissions": {
    "deny": [
      "Task",
      "Read(~/.config/mocactl/**)"
    ],
    "allow": [
      "Bash(mocactl spawn*)",
      "Bash(mocactl get*)",
      "Bash(mocactl subagents*)",
      "Bash(mocactl sessions*)",
      "Bash(kubectl -n moca-sandbox get pods*)",
      "Bash(kubectl -n moca-sandbox wait*)",
      "Bash(kubectl -n moca-sandbox exec*)",
      "Bash(kubectl -n moca-sandbox cp*)",
      "Bash(kubectl -n moca-sandbox logs*)"
    ]
  }
}
