#!/usr/bin/env bash
# moca — thin CLI wrapper around the MOCA harness HTTP API (deploy/k8s path).
#
# Four subcommands:
#   moca start <leaf-label> <prompt-file>   dispatch a leaf, write a run record
#   moca check <leaf-label>                 collect a leaf's result
#   moca list                               show run records
#   moca cancel <leaf-label>                cancel a leaf still in flight
#
# Dispatch uses MOCA's DETACHABLE TURN path: POST /v1/turn with
# {"detachable":true} and Accept: text/event-stream. The server owns the turn's
# durability — it writes every frame to a per-turn Redis Stream and does NOT
# abort the turn when the client disconnects. So `moca start` reads the stream
# only long enough to learn the turnId, then walks away; the leaf keeps running
# cluster-side. Nothing local holds the connection and there is no background
# worker to keep alive.
#
# `moca check` COLLECTS by reattaching: GET /v1/turn?sessionId=... replays the
# turn's frames from the beginning and follows it if still running. A finished
# turn replays in full for 24h (SH_TURN_LOG_TTL_S), so a result survives
# quitting Claude Code, closing the laptop, and rebooting.
#
# Two origins, two token kinds (see MOCA.md):
#   - control plane: /v1/sessions, /v1/sessions/{id}/token  -> API token
#   - harness:       /v1/turn, /v1/turn/cancel              -> SESSION token
# A session token lives ~300s and carries the session id it was minted for, so
# both `start` and `check` re-mint one immediately before use. An API token is
# rejected on /v1/turn, and vice versa.
#
# All leaves of a chain share ONE session, and therefore one sandbox workspace
# at /workspace/<sessionId>. That is what lets the fix leaf see the files the
# diagnose leaf looked at. It also means leaves must run SEQUENTIALLY: a second
# concurrent turn on the same session is refused with 409 turn_in_progress.
#
# Reads the two base URLs, the session id and the run-records dir from MOCA.md
# in the current directory (written by setup.sh). Writes run records to
# .moca-runs/ and reads the API token from .moca-auth/api.hdr.
#
# Exit codes:
#   0  success (dispatch accepted; or check reports current state)
#   1  usage error / missing deps
#   2  MOCA not reachable or returned an error (details on stderr)
#   3  run record not found (for check/cancel)

set -euo pipefail

usage() {
  cat >&2 <<EOF
usage:
  moca start <leaf-label> <prompt-file>
  moca check <leaf-label>
  moca list
  moca cancel <leaf-label>

<leaf-label> names the leaf locally (e.g. "diagnose", "fix"). It is NOT a
session id — the session is created once by setup.sh and shared by every leaf
in the chain; MOCA generates its id. The label only names files in .moca-runs/,
so it must be alphanumerics plus '-', '_', '.'.
<prompt-file> is a path to a file containing the leaf prompt text.

Reads URLs and the session id from ./MOCA.md. Writes records to ./.moca-runs/.
EOF
  exit 1
}

die() { echo "moca: $*" >&2; exit 2; }

for bin in curl jq; do
  command -v "${bin}" >/dev/null 2>&1 || { echo "moca: missing required binary: ${bin}" >&2; exit 1; }
done

read_moca_md() {
  local key="$1"
  local file="${MOCA_MD:-MOCA.md}"
  [ -f "${file}" ] || die "cannot find ${file} in $(pwd). Run from the scratch dir."
  # Lines look like "Harness URL:      http://127.0.0.1:8080"
  grep -E "^${key}:[[:space:]]" "${file}" | sed -E "s/^${key}:[[:space:]]+//" | head -1
}

CP_URL="${MOCA_CP_URL:-$(read_moca_md 'Control plane URL' || true)}"
HARNESS_URL="${MOCA_HARNESS_URL:-$(read_moca_md 'Harness URL' || true)}"
SESSION_ID="${MOCA_SESSION_ID:-$(read_moca_md 'Session id' || true)}"
RUNS_DIR="${MOCA_RUNS_DIR:-.moca-runs}"
AUTH_DIR="${MOCA_AUTH_DIR:-.moca-auth}"
API_HDR="${AUTH_DIR}/api.hdr"

[ -n "${CP_URL}" ]      || die "could not resolve control plane URL (set MOCA_CP_URL or add 'Control plane URL:' to MOCA.md)"
[ -n "${HARNESS_URL}" ] || die "could not resolve harness URL (set MOCA_HARNESS_URL or add 'Harness URL:' to MOCA.md)"
[ -n "${SESSION_ID}" ]  || die "could not resolve session id (set MOCA_SESSION_ID or add 'Session id:' to MOCA.md). Did setup.sh run?"

# How long `check` is willing to follow a still-running turn before reporting
# "running". This bound is LOAD-BEARING: the server's attach handler follows a
# live turn until it ends, so without --max-time `check` would block exactly
# like a synchronous call. A timeout here is the normal "still running"
# outcome, not an error.
MOCA_CHECK_TIMEOUT="${MOCA_CHECK_TIMEOUT:-20}"

# How long `start` waits for the first 'turn' frame, which carries the turnId.
# Must be generous enough to cover session rehydration and sandbox selection.
# Note the server does NOT start the turn at all if the client is already gone
# when it goes to begin, so this must not be aggressively short.
MOCA_START_TIMEOUT="${MOCA_START_TIMEOUT:-60}"

# The label names local files only — the session id is server-generated and
# always a UUID, so it needs no validation.
validate_label() {
  local label="$1"
  if ! printf '%s' "${label}" | grep -qE '^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$'; then
    die "invalid leaf label '${label}'. Use alphanumerics plus '-', '_', '.' (e.g. diagnose, fix)."
  fi
}

record_path() { echo "${RUNS_DIR}/$(printf '%s' "$1" | tr '/' '-').json"; }
sse_path()    { echo "${RUNS_DIR}/$(printf '%s' "$1" | tr '/' '-').sse"; }
answer_path() { echo "${RUNS_DIR}/$(printf '%s' "$1" | tr '/' '-').answer.txt"; }

# Update a record in place, applying a jq filter with optional --arg pairs.
update_record() {
  local record="$1"; shift
  jq "$@" "${record}" >"${record}.tmp" && mv "${record}.tmp" "${record}"
}

# Mint a fresh session token and write it to a 0600 header file, echoing the
# path. Session tokens expire in ~300s, so this runs immediately before every
# harness call rather than being cached.
#
# Tokens go in header FILES, never on the curl command line: argv is
# world-readable via ps.
session_token_hdr() {
  [ -f "${API_HDR}" ] || die "no API token at ${API_HDR}. Re-run setup.sh (or 'mocactl login' then setup.sh)."
  local out="${AUTH_DIR}/session.hdr"
  local response http_code body token
  response="$(curl -sS -w '\n%{http_code}' \
    -X POST -H @"${API_HDR}" \
    "${CP_URL}/v1/sessions/$(printf '%s' "${SESSION_ID}" | jq -sRr @uri)/token")" \
    || die "cannot reach the control plane at ${CP_URL}. Is the port-forward running?"
  http_code="$(printf '%s' "${response}" | tail -1)"
  body="$(printf '%s' "${response}" | sed '$d')"

  case "${http_code}" in
    200) : ;;
    401|403)
      die "control plane rejected the API token (HTTP ${http_code}). It may have expired, or it belongs to a different user than the one that created session ${SESSION_ID}. Re-run setup.sh."
      ;;
    404)
      die "session ${SESSION_ID} not found (HTTP 404). It was deleted (teardown.sh) or expired. Re-run setup.sh to start a new chain."
      ;;
    *)
      die "could not mint a session token (HTTP ${http_code}). body=${body}"
      ;;
  esac

  token="$(printf '%s' "${body}" | jq -r '.token // empty')"
  [ -n "${token}" ] || die "control plane returned no token. body=${body}"
  mkdir -p "${AUTH_DIR}"
  ( umask 077; printf 'Authorization: Bearer %s\n' "${token}" >"${out}" )
  echo "${out}"
}

# Rebuild a leaf's answer from an SSE transcript by concatenating the deltas of
# every 'text' frame in order. The model's prose arrives as a stream of deltas,
# so this is the only way to recover it.
extract_answer() {
  sed -n 's/^data: //p' "$1" | jq -j 'select(.type == "text") | .delta' 2>/dev/null || true
}

# Terminal frame, if the transcript has one: exactly one 'done' or 'error' ends
# a turn.
terminal_frame() {
  sed -n 's/^data: //p' "$1" \
    | jq -c 'select(.type == "done" or .type == "error")' 2>/dev/null | tail -1
}

# The tool calls a leaf made, for operators who want to see the work.
print_tool_results() {
  sed -n 's/^data: //p' "$1" \
    | jq -r 'select(.type == "tool_result" and (.isError | not)) | .preview' 2>/dev/null || true
}

cmd_start() {
  [ $# -eq 2 ] || usage
  local label="$1" prompt_file="$2"
  validate_label "${label}"
  [ -f "${prompt_file}" ] || die "prompt file not found: ${prompt_file}"

  mkdir -p "${RUNS_DIR}"
  local record ssep
  record="$(record_path "${label}")"
  ssep="$(sse_path "${label}")"
  if [ -f "${record}" ]; then
    local existing
    existing="$(jq -r '.status' <"${record}" 2>/dev/null || echo unknown)"
    die "record already exists for '${label}' (status=${existing}): ${record}. Use a new label, or 'moca check ${label}'."
  fi

  local hdr
  hdr="$(session_token_hdr)"

  local body
  body="$(jq -n --arg sid "${SESSION_ID}" --rawfile p "${prompt_file}" \
    '{sessionId:$sid, prompt:$p, detachable:true}')"

  # Write the record BEFORE dispatching so one always exists on disk even if
  # this process dies mid-call; `moca list` can then show it.
  jq -n --arg l "${label}" --arg sid "${SESSION_ID}" \
        --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg sp "${ssep}" \
    '{leaf:$l, sessionId:$sid, turnId:null, dispatchedAt:$at,
      status:"dispatching", mode:"detachable-turn", cursor:null, ssePath:$sp}' \
    >"${record}"

  # Open the stream, keep only what arrives before the first 'turn' frame, and
  # stop reading. The turn continues server-side: the detachable path registers
  # a disconnect as "nobody is watching", not as a cancellation.
  #
  # curl writes into the transcript; we tail it for the turn frame rather than
  # piping, so that closing our reader cannot truncate a partial write.
  : >"${ssep}"
  local curl_rc=0
  curl -sN --max-time "${MOCA_START_TIMEOUT}" \
    -X POST \
    -H @"${hdr}" \
    -H 'Accept: text/event-stream' \
    -H 'Content-Type: application/json' \
    -o "${ssep}" \
    -w '%{http_code}' \
    -d "${body}" \
    "${HARNESS_URL}/v1/turn" >"${ssep}.code" 2>/dev/null &
  local curl_pid=$!

  # Wait for the turn frame (which carries turnId) to land, then let go.
  local turn_id="" waited=0
  while [ "${waited}" -lt "${MOCA_START_TIMEOUT}" ]; do
    if [ -s "${ssep}" ]; then
      turn_id="$(sed -n 's/^data: //p' "${ssep}" \
        | jq -r 'select(.type == "turn") | .turnId' 2>/dev/null | head -1 || true)"
      [ -n "${turn_id}" ] && break
    fi
    # The server may also have refused outright (4xx/5xx), in which case curl
    # exits without ever emitting a turn frame.
    kill -0 "${curl_pid}" 2>/dev/null || break
    sleep 1
    waited=$((waited + 1))
  done

  if [ -n "${turn_id}" ]; then
    # Detach: stop watching, leave the turn running.
    kill "${curl_pid}" 2>/dev/null || true
    wait "${curl_pid}" 2>/dev/null || curl_rc=$?
    update_record "${record}" --arg t "${turn_id}" '.turnId = $t | .status = "running"'
    echo "dispatched '${label}' as a detachable turn"
    echo "  session: ${SESSION_ID}"
    echo "  turn:    ${turn_id}"
    echo "  record:  ${record}"
    echo ""
    echo "The turn is running cluster-side and does not need this process."
    echo "Collect it with: moca check ${label}"
    return 0
  fi

  # No turn frame: the dispatch was refused, or nothing arrived in time.
  wait "${curl_pid}" 2>/dev/null || curl_rc=$?
  local http_code
  http_code="$(cat "${ssep}.code" 2>/dev/null || echo '000')"
  rm -f "${ssep}.code"

  case "${http_code}" in
    409)
      update_record "${record}" '.status = "refused" | .reason = "turn_in_progress"'
      echo "status=refused (HTTP 409 turn_in_progress)" >&2
      echo "" >&2
      echo "Another leaf of this chain is still running. All leaves share one" >&2
      echo "session, and a session runs one turn at a time — so leaves must be" >&2
      echo "sequential. Collect the leaf in flight first:" >&2
      echo "    moca list        # find the running leaf" >&2
      echo "    moca check <it>  # collect it" >&2
      echo "then dispatch '${label}' again (delete ${record} first)." >&2
      exit 2
      ;;
    401|403)
      update_record "${record}" --arg c "${http_code}" '.status = "failed" | .httpCode = $c'
      die "harness rejected the session token (HTTP ${http_code}). A session token is required on /v1/turn and lives only ~300s; this one was minted seconds ago, so check that MOCA.md's session id matches the token's session."
      ;;
    503)
      update_record "${record}" '.status = "saturated"'
      echo "status=saturated (HTTP 503) — no capacity right now. Nothing ran." >&2
      echo "Delete ${record} and re-dispatch shortly." >&2
      exit 2
      ;;
    000|'')
      update_record "${record}" '.status = "unknown"'
      die "no response from the harness at ${HARNESS_URL} within ${MOCA_START_TIMEOUT}s. Is the port-forward running? The turn MAY have started — try 'moca check ${label}' before re-dispatching."
      ;;
    *)
      update_record "${record}" --arg c "${http_code}" '.status = "failed" | .httpCode = $c'
      die "dispatch failed (HTTP ${http_code}). Transcript: ${ssep}"
      ;;
  esac
}

cmd_check() {
  [ $# -eq 1 ] || usage
  local label="$1"
  validate_label "${label}"
  local record
  record="$(record_path "${label}")"
  [ -f "${record}" ] || { echo "moca: no record for '${label}' at ${record}" >&2; exit 3; }

  local status
  status="$(jq -r '.status // ""' <"${record}")"

  # Terminal states already collected: just reprint, no network call.
  if [ "${status}" = "done" ]; then
    echo "status=done (already collected)"
    cat "$(answer_path "${label}")" 2>/dev/null || true
    return 0
  fi
  if [ "${status}" = "saturated" ] || [ "${status}" = "refused" ]; then
    echo "status=${status} — nothing ran, so there is nothing to collect."
    echo "Delete ${record} and re-dispatch."
    return 0
  fi

  local ssep hdr
  ssep="$(jq -r '.ssePath' <"${record}")"
  hdr="$(session_token_hdr)"

  # Reattach and replay from the BEGINNING of the turn. We deliberately do not
  # send Last-Event-ID: a cursor at or past the tail of a FINISHED turn makes
  # the server answer with just the turn frame (ended:true) and no text frames
  # at all — which would look like an empty answer. The 24h log holds the whole
  # turn, so a full replay is both correct and cheap.
  local fresh="${ssep}.live" curl_rc=0 http_code
  : >"${fresh}"
  http_code="$(curl -sN --max-time "${MOCA_CHECK_TIMEOUT}" \
    -H @"${hdr}" \
    -H 'Accept: text/event-stream' \
    -o "${fresh}" \
    -w '%{http_code}' \
    --get --data-urlencode "sessionId=${SESSION_ID}" \
    "${HARNESS_URL}/v1/turn" 2>/dev/null)" || curl_rc=$?

  # curl 28 is the --max-time cutoff: expected when following a live turn.
  if [ "${curl_rc}" -ne 0 ] && [ "${curl_rc}" -ne 28 ]; then
    rm -f "${fresh}"
    die "could not reach the harness at ${HARNESS_URL} (curl ${curl_rc}). Is the port-forward running?"
  fi

  if [ "${curl_rc}" -eq 0 ]; then
    case "${http_code}" in
      200) : ;;
      404)
        rm -f "${fresh}"
        update_record "${record}" '.status = "lost"'
        echo "status=lost (HTTP 404 turn_not_found)"
        echo ""
        echo "MOCA holds no turn log for this session. Either the turn never"
        echo "started, or its log aged out (results are kept 24h). The answer"
        echo "is not recoverable — re-dispatch under a new label."
        return 0
        ;;
      401|403)
        rm -f "${fresh}"
        die "harness rejected the session token (HTTP ${http_code}) when reattaching."
        ;;
      503)
        rm -f "${fresh}"
        echo "status=running (HTTP 503 redis_unavailable — MOCA's log store is briefly unavailable)"
        echo "The turn is unaffected. Try 'moca check ${label}' again shortly."
        return 0
        ;;
      *)
        rm -f "${fresh}"
        die "reattach failed (HTTP ${http_code})."
        ;;
    esac
  fi

  # Keep the replay as the authoritative transcript.
  mv "${fresh}" "${ssep}"

  # A trimmed log means the replay skipped frames.
  if sed -n 's/^data: //p' "${ssep}" | jq -e 'select(.type == "turn" and .truncated == true)' >/dev/null 2>&1; then
    echo "note: MOCA trimmed this turn's log, so the transcript is partial." >&2
  fi

  local term
  term="$(terminal_frame "${ssep}")"

  if [ -z "${term}" ]; then
    # No terminal frame yet (including the --max-time cutoff): still running.
    update_record "${record}" '.status = "running"'
    echo "status=running"
    echo ""
    echo "The leaf is still working. Reattaching does not disturb it — check"
    echo "again in a little while."
    return 0
  fi

  local ttype
  ttype="$(printf '%s' "${term}" | jq -r '.type')"

  if [ "${ttype}" = "done" ]; then
    local answerp
    answerp="$(answer_path "${label}")"
    extract_answer "${ssep}" >"${answerp}"
    update_record "${record}" '.status = "done"'
    echo "status=done"
    echo "transcript: ${ssep}"
    echo ""
    cat "${answerp}"
    return 0
  fi

  # type == error
  local reason abort msg
  reason="$(printf '%s' "${term}" | jq -r '.stopReason // empty')"
  abort="$(printf '%s' "${term}" | jq -r '.abortReason // empty')"
  msg="$(printf '%s' "${term}" | jq -r '.errorMessage // empty')"

  update_record "${record}" --arg a "${abort}" '.status = "failed" | .abortReason = $a'
  echo "status=failed"
  echo "transcript: ${ssep}"
  [ -n "${reason}" ] && echo "stopReason: ${reason}" || true
  [ -n "${msg}" ]    && echo "message: ${msg}" || true

  # The abort reasons are infrastructure outcomes, not findings about the code
  # under review. Say so, or they read as the leaf's verdict.
  case "${abort}" in
    unwatched)
      echo ""
      echo "MOCA aborted this turn because nobody was attached to it for 30"
      echo "minutes while it ran. This is an infrastructure timeout, not a"
      echo "result: the leaf did not finish its work. Re-dispatch under a new"
      echo "label and run 'moca check' sooner — checking resets the clock."
      ;;
    restarting)
      echo ""
      echo "MOCA's supervisor restarted while this turn was in flight, which"
      echo "aborts detached turns. Infrastructure, not a result. Re-dispatch"
      echo "under a new label."
      ;;
    cancelled)
      echo ""
      echo "This turn was cancelled (moca cancel, or an operator elsewhere)."
      ;;
    lease_lost|owner_lost)
      echo ""
      echo "MOCA lost ownership of this turn (${abort}) and abandoned it."
      echo "Infrastructure, not a result. Re-dispatch under a new label."
      ;;
    '') : ;;
    *)
      echo "abortReason: ${abort}"
      ;;
  esac
  return 0
}

cmd_cancel() {
  [ $# -eq 1 ] || usage
  local label="$1"
  validate_label "${label}"
  local record
  record="$(record_path "${label}")"
  [ -f "${record}" ] || { echo "moca: no record for '${label}' at ${record}" >&2; exit 3; }

  local turn_id hdr
  turn_id="$(jq -r '.turnId // empty' <"${record}")"
  [ -n "${turn_id}" ] || die "record for '${label}' has no turnId, so there is nothing to cancel."
  hdr="$(session_token_hdr)"

  local response http_code
  response="$(curl -sS -w '\n%{http_code}' \
    -X POST -H @"${hdr}" -H 'Content-Type: application/json' \
    -d "$(jq -n --arg s "${SESSION_ID}" --arg t "${turn_id}" '{sessionId:$s, turnId:$t}')" \
    "${HARNESS_URL}/v1/turn/cancel")" \
    || die "could not reach the harness at ${HARNESS_URL}."
  http_code="$(printf '%s' "${response}" | tail -1)"

  case "${http_code}" in
    200|202|204)
      update_record "${record}" '.status = "cancelled"'
      echo "cancelled '${label}' (turn ${turn_id})"
      ;;
    404)
      update_record "${record}" '.status = "lost"'
      echo "no such turn (HTTP 404) — it already ended or its log aged out."
      ;;
    *)
      die "cancel failed (HTTP ${http_code})."
      ;;
  esac
}

cmd_list() {
  [ -d "${RUNS_DIR}" ] || { echo "(no ${RUNS_DIR} yet)"; return 0; }
  local any=0
  for rec in "${RUNS_DIR}"/*.json; do
    [ -f "${rec}" ] || continue
    any=1
    local leaf status note
    leaf="$(jq -r '.leaf // "?"' <"${rec}" 2>/dev/null || echo '?')"
    status="$(jq -r '.status // "?"' <"${rec}" 2>/dev/null || echo '?')"
    note=""
    # Status comes from the record alone: durability is the server's job now,
    # so there is no local process whose liveness could mean anything.
    case "${status}" in
      running)   note="	(check to collect)" ;;
      saturated) note="	(nothing ran — re-dispatch)" ;;
      refused)   note="	(409 — a leaf was already in flight)" ;;
      lost)      note="	(no server-side log — re-dispatch)" ;;
    esac
    printf '%s\t%s%s\n' "${status}" "${leaf}" "${note}"
  done
  [ "${any}" -eq 0 ] && echo "(no run records)"
  return 0
}

[ $# -ge 1 ] || usage
sub="$1"; shift
case "${sub}" in
  start)  cmd_start "$@" ;;
  check)  cmd_check "$@" ;;
  list)   cmd_list "$@" ;;
  cancel) cmd_cancel "$@" ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
