.beads
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# bd init also drops these — keep them local, out of the repo
.agents/
.claude/
.codex/
AGENTS.md
CLAUDE.md

# Exception: moca_chained_subagents promotes `.claude/` subtrees as config
# bundles; those are first-class demo artifacts, not bd init leftovers.
!moca_chained_subagents/bundles/*/.claude/
!moca_chained_subagents/bundles/*/.claude/**
