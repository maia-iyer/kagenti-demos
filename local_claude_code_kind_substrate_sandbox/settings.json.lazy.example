{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/substrate-sandbox-hook session-end-lazy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/bin/substrate-sandbox-hook check-bash-lazy"
          }
        ]
      }
    ]
  }
}
